	echo 'set timeout=0'; \
	echo 'set default=0'; \
	echo 'set gfxpayload=1024x768x32'; \
	echo 'menuentry "OS" {'; \
	echo '  multiboot2 /boot/os.bin'; \
	echo '  module2 /boot/initrd.tar'; \
	echo '  boot'; \
	echo '}'; \
} > isodir/boot/grub/grub.cfg
