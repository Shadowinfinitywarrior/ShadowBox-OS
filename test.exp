#!/usr/bin/expect -f
set timeout 10
spawn qemu-system-x86_64 -cdrom os.iso -display none -serial stdio -no-reboot -m 128M
expect -re "\033\[32msh\033\[33m\[\033\[36m\[0-9]+\033\[33m\]\033\[32m \\\$ \033\[0m"
send "run hello.elf\r"
expect -re {Hello from spawned process!}
expect -re "\033\[32msh\033\[33m\[\033\[36m\[0-9]+\033\[33m\]\033\[32m \\\$ \033\[0m"
send "exit\r"
expect eof
